# Optional. Overrides config/portfolio.config.ts dataSource at runtime.
# Point at any raw JSON URL — GitHub, a CDN, object storage, your own host.
NEXT_PUBLIC_PORTFOLIO_URL=https://raw.githubusercontent.com/USERNAME/REPO/main/portfolio.json

# How long (seconds) a remote fetch is cached before revalidation.
PORTFOLIO_REVALIDATE=3600

# ------------------------------------------------------------------------------
# Admin dashboard (optional, private). Disabled until you set the two login
# credentials below. Sign in at /admin/login; the read-only view is
# /admin/dashboard. Auth is enforced server-side: a signed, HttpOnly,
# SameSite=Strict session cookie, re-verified on every render. No client-side
# gate that could be bypassed. No external service, no build config needed.
# On Vercel: Settings -> Environment Variables, Production (and Preview if
# you want it in previews). The cookie becomes Secure automatically in prod.
# ------------------------------------------------------------------------------

# Login credential, email half of the constant-time sign-in gate.
# ANALYTICS_ADMIN_EMAIL=admin@example.com

# Login credential, password half of the constant-time sign-in gate.
# ANALYTICS_ADMIN_PASSWORD=change-me-to-a-strong-password

# Recommended. HMAC session-signing secret. If unset, it is derived from the
# two credentials, which is stable while they are unchanged.
# ANALYTICS_ADMIN_SECRET=

# Optional. Snapshot directory so warm restarts restore aggregates instead of
# resetting to zero. On Vercel use /tmp/analytics: per-instance, ephemeral.
# # ANALYTICS_SNAPSHOT_DIR=
