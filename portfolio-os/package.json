{
  "name": "portfolio-os",
  "version": "1.0.0",
  "private": true,
  "description": "A forkable, data-driven personal technology OS. Content lives in portfolio.json; the app is the renderer.",
  "scripts": {
    "dev": "next dev",
    "index": "tsx scripts/index-portfolio.ts --with-embeddings",
    "build": "tsx scripts/check-index.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "test": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/*.test.ts",
    "check:server": "node scripts/check-server-freshness.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "highlight.js": "11.10.0",
    "katex": "0.16.11",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
